        // --- 3. GEOMETRY GENERATORS WITH BEND RADIUS & HOOKS ---
        function createHookedBarGeometry(length, hookHeight, radius, bendRadius) {
            const path = new THREE.CurvePath();
            const halfL = length / 2;
            const r = bendRadius;
            const h = hookHeight;

            const p1 = new THREE.Vector3(-halfL, h, 0);
            const p2 = new THREE.Vector3(-halfL, r, 0);
            const p3 = new THREE.Vector3(-halfL + r, 0, 0);
            const p4 = new THREE.Vector3(halfL - r, 0, 0);
            const p5 = new THREE.Vector3(halfL, r, 0);
            const p6 = new THREE.Vector3(halfL, h, 0);

            path.add(new THREE.LineCurve3(p1, p2));
            path.add(new THREE.QuadraticBezierCurve3(p2, new THREE.Vector3(-halfL, 0, 0), p3));
            path.add(new THREE.LineCurve3(p3, p4));
            path.add(new THREE.QuadraticBezierCurve3(p4, new THREE.Vector3(halfL, 0, 0), p5));
            path.add(new THREE.LineCurve3(p5, p6));

            return new THREE.TubeGeometry(path, 32, radius, 6, false);
        }

        function createLSpliceBarGeometry(straightLen, hookLen, radius, bendRadius) {
            const path = new THREE.CurvePath();
            const r = bendRadius;

            const p1 = new THREE.Vector3(0, straightLen, 0);
            const p2 = new THREE.Vector3(0, r, 0);
            const p3 = new THREE.Vector3(r, 0, 0);
            const p4 = new THREE.Vector3(hookLen, 0, 0);

            path.add(new THREE.LineCurve3(p1, p2));
            path.add(new THREE.QuadraticBezierCurve3(p2, new THREE.Vector3(0, 0, 0), p3));
            path.add(new THREE.LineCurve3(p3, p4));

            return new THREE.TubeGeometry(path, 32, radius, 6, false);
        }

        function createSeismicStirrup135Geometry(w, d, radius, bendRadius) {
            const path = new THREE.CurvePath();
            const hw = w / 2;
            const hd = d / 2;
            const r = bendRadius;
            const hookVal = 0.06; // 135-degree hook length

            const c1_start = new THREE.Vector3(-hw + r, 0, -hd);
            const c1_center = new THREE.Vector3(-hw, 0, -hd);
            const c2_start = new THREE.Vector3(hw - r, 0, -hd);
            const c2_center = new THREE.Vector3(hw, 0, -hd);
            const c2_end = new THREE.Vector3(hw, 0, -hd + r);
            const c3_start = new THREE.Vector3(hw, 0, hd - r);
            const c3_center = new THREE.Vector3(hw, 0, hd);
            const c3_end = new THREE.Vector3(hw - r, 0, hd);
            const c4_start = new THREE.Vector3(-hw + r, 0, hd);
            const c4_center = new THREE.Vector3(-hw, 0, hd);
            const c4_end = new THREE.Vector3(-hw, 0, hd - r);

            const hook1_end = new THREE.Vector3(-hw + hookVal, 0, -hd + hookVal);

            path.add(new THREE.LineCurve3(hook1_end, c1_start));
            path.add(new THREE.LineCurve3(c1_start, c2_start));
            path.add(new THREE.QuadraticBezierCurve3(c2_start, c2_center, c2_end));
            path.add(new THREE.LineCurve3(c2_end, c3_start));
            path.add(new THREE.QuadraticBezierCurve3(c3_start, c3_center, c3_end));
            path.add(new THREE.LineCurve3(c3_end, c4_start));
            path.add(new THREE.QuadraticBezierCurve3(c4_start, c4_center, c4_end));
            path.add(new THREE.LineCurve3(c4_end, new THREE.Vector3(-hw, 0, -hd + r)));
            path.add(new THREE.QuadraticBezierCurve3(new THREE.Vector3(-hw, 0, -hd + r), c1_center, c1_start));
            path.add(new THREE.LineCurve3(c1_start, new THREE.Vector3(-hw + hookVal, 0, -hd + hookVal * 0.5)));

            return new THREE.TubeGeometry(path, 48, radius, 6, false);
        }

        function createPerimeterTieGeometry(w, d, radius, bendRadius) {
            const path = new THREE.CurvePath();
            const hw = w / 2;
            const hd = d / 2;
            const r = bendRadius;
            const overlap = 0.15;

            const c1_start = new THREE.Vector3(-hw + r, 0, -hd);
            const c1_center = new THREE.Vector3(-hw, 0, -hd);
            const c2_start = new THREE.Vector3(hw - r, 0, -hd);
            const c2_center = new THREE.Vector3(hw, 0, -hd);
            const c2_end = new THREE.Vector3(hw, 0, -hd + r);
            const c3_start = new THREE.Vector3(hw, 0, hd - r);
            const c3_center = new THREE.Vector3(hw, 0, hd);
            const c3_end = new THREE.Vector3(hw - r, 0, hd);
            const c4_start = new THREE.Vector3(-hw + r, 0, hd);
            const c4_center = new THREE.Vector3(-hw, 0, hd);
            const c4_end = new THREE.Vector3(-hw, 0, hd - r);

            const startPt = new THREE.Vector3(-hw + r, 0, -hd + 0.005);
            const endPt = new THREE.Vector3(-hw + r + overlap, 0, -hd + 0.005);

            path.add(new THREE.LineCurve3(startPt, c2_start));
            path.add(new THREE.QuadraticBezierCurve3(c2_start, c2_center, c2_end));
            path.add(new THREE.LineCurve3(c2_end, c3_start));
            path.add(new THREE.QuadraticBezierCurve3(c3_start, c3_center, c3_end));
            path.add(new THREE.LineCurve3(c3_end, c4_start));
            path.add(new THREE.QuadraticBezierCurve3(c4_start, c4_center, c4_end));
            path.add(new THREE.LineCurve3(c4_end, new THREE.Vector3(-hw, 0, -hd + r)));
            path.add(new THREE.QuadraticBezierCurve3(new THREE.Vector3(-hw, 0, -hd + r), c1_center, c1_start));
            path.add(new THREE.LineCurve3(c1_start, endPt));

            return new THREE.TubeGeometry(path, 48, radius, 6, false);
        }

        // --- 4. BUILD 3D REBAR & CONCRETE ---
        function buildCompleteModel() {
            clearGroup(concreteGroup);
            clearGroup(rebarGroup);
            clearGroup(perimTieGroup);
            clearGroup(superstructureGroup);
            interactiveObjects = [];

            const colSize = 0.20;
            const cover = 0.04;

            foundationData.forEach(item => {
                const type = footingTypes[item.type];
                const posX = gridX[item.xName];
                const posZ = gridZ[item.zName];
                const posY = type.h / 2 - 0.2;

                // Concrete Block
                const fGeo = new THREE.BoxGeometry(type.b, type.h, type.l);
                const fMesh = new THREE.Mesh(fGeo, concreteMat);
                fMesh.position.set(posX, posY, posZ);
                fMesh.castShadow = true;
                concreteGroup.add(fMesh);

                const cGeo = new THREE.BoxGeometry(colSize, stubHeight, colSize);
                const cMesh = new THREE.Mesh(cGeo, concreteMat);
                cMesh.position.set(posX, type.h - 0.2 + stubHeight/2, posZ);
                cMesh.castShadow = true;
                concreteGroup.add(cMesh);

                fMesh.userData = { ...item, typeData: type };
                interactiveObjects.push(fMesh);

                // Rebar Subgroups
                const rebarSubGroup = new THREE.Group();
                const pTieSubGroup = new THREE.Group();

                const meshMat = isMetallicMode ? metallicRebarMat : meshRebarMat;
                const mainMat = isMetallicMode ? metallicRebarMat : mainRebarMat;
                const tieMat = isMetallicMode ? metallicRebarMat : tieRebarMat;
                const pTieMat = isMetallicMode ? metallicRebarMat : perimTieMat;

                // 1. Mesh
                const meshNum = parseInt(type.meshSpec.split('+')[0]);
                const radiusMesh = type.meshSpec.includes('DB16') ? 0.008 : 0.006;
                const stepX = (type.b - 2 * cover) / (meshNum - 1);
                const stepZ = (type.l - 2 * cover) / (meshNum - 1);
                const hookH = type.h - 2 * cover;
                const bendR = radiusMesh * 3.5;

                for (let i = 0; i < meshNum; i++) {
                    const zBar = posZ - (type.l/2 - cover) + i * stepZ;
                    const barGeo = createHookedBarGeometry(type.b - 2*cover, hookH, radiusMesh, bendR);
                    const barMesh = new THREE.Mesh(barGeo, meshMat);
                    barMesh.position.set(posX, -0.2 + cover, zBar);
                    rebarSubGroup.add(barMesh);
                }

                for (let i = 0; i < meshNum; i++) {
                    const xBar = posX - (type.b/2 - cover) + i * stepX;
                    const barGeo = createHookedBarGeometry(type.l - 2*cover, hookH, radiusMesh, bendR);
                    const barMesh = new THREE.Mesh(barGeo, meshMat);
                    barMesh.rotation.y = Math.PI / 2;
                    barMesh.position.set(xBar, -0.2 + cover + radiusMesh*2, posZ);
                    rebarSubGroup.add(barMesh);
                }

                // 2. Perimeter Side Tie (เหล็กรัดรอบฐานราก)
                const pTieRadius = 0.0045;
                const pTieW = type.b - 2 * cover - 0.01;
                const pTieL = type.l - 2 * cover - 0.01;
                const pTieY = -0.2 + (type.h / 2);
                
                const perimGeo = createPerimeterTieGeometry(pTieW, pTieL, pTieRadius, pTieRadius * 3);
                const perimMesh = new THREE.Mesh(perimGeo, pTieMat);
                perimMesh.position.set(posX, pTieY, posZ);
                pTieSubGroup.add(perimMesh);

                // 3. Column Main Dowels
                const mainBarNum = parseInt(type.mainBar.split('-')[0]);
                const radiusMain = type.mainBar.includes('DB16') ? 0.008 : 0.006;
                const colCover = 0.03;
                const innerCol = colSize/2 - colCover;
                const hookL = Math.max(0.20, type.b * 0.35);

                const cornerPositions = [
                    { x: posX - innerCol, z: posZ - innerCol, rot: 0 },
                    { x: posX + innerCol, z: posZ - innerCol, rot: -Math.PI/2 },
                    { x: posX + innerCol, z: posZ + innerCol, rot: Math.PI },
                    { x: posX - innerCol, z: posZ + innerCol, rot: Math.PI/2 }
                ];

                if (mainBarNum === 6) {
                    cornerPositions.push(
                        { x: posX - innerCol, z: posZ, rot: 0 },
                        { x: posX + innerCol, z: posZ, rot: Math.PI }
                    );
                }

                const barTotalLen = stubHeight + type.h;
                cornerPositions.forEach(pos => {
                    const colBarGeo = createLSpliceBarGeometry(barTotalLen, hookL, radiusMain, radiusMain * 4);
                    const colBarMesh = new THREE.Mesh(colBarGeo, mainMat);
                    colBarMesh.rotation.y = pos.rot;
                    colBarMesh.position.set(pos.x, -0.2 + cover + 0.015, pos.z);
                    rebarSubGroup.add(colBarMesh);
                });

                // 4. Column Stirrups
                const tieRadius = 0.0045;
                const tiePitch = 0.15;
                const tieCount = Math.floor(stubHeight / tiePitch);
                const tieWidth = colSize - 2 * colCover;
                const tieDepth = colSize - 2 * colCover;

                for (let k = 0; k <= tieCount; k++) {
                    const tieY = (-0.2 + type.h) + k * tiePitch;
                    const tieGeo = createSeismicStirrup135Geometry(tieWidth, tieDepth, tieRadius, tieRadius * 2.5);
                    const tieMesh = new THREE.Mesh(tieGeo, tieMat);
                    tieMesh.position.set(posX, tieY, posZ);
                    rebarSubGroup.add(tieMesh);
                }

                rebarGroup.add(rebarSubGroup);
                perimTieGroup.add(pTieSubGroup);
            });

            buildSuperstructure3D();
        }

        function buildSuperstructure3D() {
            const beamY = -0.2 + stubHeight + 0.2;
            const beamRadius = 0.006;
            const mat = isMetallicMode ? metallicRebarMat : beamRebarMat;

            ['1', '2', '3'].forEach(xK => {
                const x = gridX[xK];
                const zStart = gridZ['E'];
                const zEnd = gridZ['A'];
                
                for(let offset of [-0.08, 0.08]) {
                    const path = new THREE.LineCurve3(new THREE.Vector3(x+offset, beamY, zStart), new THREE.Vector3(x+offset, beamY, zEnd));
                    const geo = new THREE.TubeGeometry(path, 32, beamRadius, 6, false);
                    const mesh = new THREE.Mesh(geo, mat);
                    superstructureGroup.add(mesh);
                }
            });

            ['A', 'B', 'C', 'D', 'E'].forEach(zK => {
                const z = gridZ[zK];
                const xStart = gridX['1'];
                const xEnd = gridX['3'];

                for(let offset of [-0.08, 0.08]) {
                    const path = new THREE.LineCurve3(new THREE.Vector3(xStart, beamY, z+offset), new THREE.Vector3(xEnd, beamY, z+offset));
                    const geo = new THREE.TubeGeometry(path, 32, beamRadius, 6, false);
                    const mesh = new THREE.Mesh(geo, mat);
                    superstructureGroup.add(mesh);
                }
            });
        }

        function createGroundAndGrid() {
            clearGroup(gridGroup);
            const gridHelper = new THREE.GridHelper(18, 18, 0x0284c7, 0x334155);
            gridHelper.position.y = -0.35;
            gridGroup.add(gridHelper);

            const groundGeo = new THREE.PlaneGeometry(18, 20);
            const groundMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.9 });
            const ground = new THREE.Mesh(groundGeo, groundMat);
            ground.rotation.x = -Math.PI / 2;
            ground.position.y = -0.36;
            gridGroup.add(ground);

            Object.keys(gridX).forEach(k => gridGroup.add(makeGridSprite(k, gridX[k], -0.3, -7.5)));
            Object.keys(gridZ).forEach(k => gridGroup.add(makeGridSprite(k, -5.5, -0.3, gridZ[k])));
        }

        function makeGridSprite(text, x, y, z) {
            const canvas = document.createElement('canvas');
            canvas.width = 64; canvas.height = 64;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#0284c7';
            ctx.beginPath(); ctx.arc(32, 32, 28, 0, Math.PI * 2); ctx.fill();
            ctx.fillStyle = '#ffffff';
            ctx.font = 'Bold 28px Prompt';
            ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            ctx.fillText(text, 32, 32);

            const texture = new THREE.CanvasTexture(canvas);
            const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: texture }));
            sprite.scale.set(1.2, 1.2, 1);
            sprite.position.set(x, y, z);
            return sprite;
        }

        // --- 5. BOQ CALCULATIONS ---
        function calculateBOQ() {
            const pSteelDB = parseFloat(document.getElementById('price-steel-db').value) || 0;
            const pSteelRB = parseFloat(document.getElementById('price-steel-rb').value) || 0;
            const pConc = parseFloat(document.getElementById('price-conc').value) || 0;
            const pForm = parseFloat(document.getElementById('price-formwork').value) || 0;

            let totalVolConc = 0;
            let totalFormworkArea = 0;
            let totalWeightDB12 = 0;
            let totalWeightDB16 = 0;
            let totalWeightRB9 = 0;

            const breakdownData = [];

            foundationData.forEach(item => {
                const t = footingTypes[item.type];
                const cover = 0.04;
                const colCover = 0.03;

                const volFooting = t.b * t.l * t.h;
                const volColumn = 0.20 * 0.20 * stubHeight;
                const footingForm = (2 * (t.b + t.l)) * t.h;
                const columnForm = (4 * 0.20) * stubHeight;

                totalVolConc += (volFooting + volColumn);
                totalFormworkArea += (footingForm + columnForm);

                // Mesh Length
                const meshNum = parseInt(t.meshSpec.split('+')[0]);
                const isDB16Mesh = t.meshSpec.includes('DB16');
                const meshBarLen = (t.b - 2*cover) + 2 * (t.h - 2*cover);
                const totalMeshLen = (meshNum * 2) * meshBarLen;

                // Perimeter Tie Length
                const perimLen = 2 * (t.b - 2*cover + t.l - 2*cover) + 0.15;
                const wPerim = perimLen * REBAR_WEIGHT['RB9'];

                // Column Main
                const mainNum = parseInt(t.mainBar.split('-')[0]);
                const isDB16Main = t.mainBar.includes('DB16');
                const dowelLen = (stubHeight + t.h) + (t.b * 0.35);
                const totalMainLen = mainNum * dowelLen;

                // Stirrups
                const tiePitch = 0.15;
                const tieCount = Math.floor(stubHeight / tiePitch) + 1;
                const singleTiePerimeter = 4 * (0.20 - 2*colCover) + 0.10;
                const totalTieLen = tieCount * singleTiePerimeter;

                const wMesh = totalMeshLen * (isDB16Mesh ? REBAR_WEIGHT['DB16'] : REBAR_WEIGHT['DB12']);
                const wMain = totalMainLen * (isDB16Main ? REBAR_WEIGHT['DB16'] : REBAR_WEIGHT['DB12']);
                const wTie = totalTieLen * REBAR_WEIGHT['RB9'];

                if (isDB16Mesh) totalWeightDB16 += wMesh; else totalWeightDB12 += wMesh;
                if (isDB16Main) totalWeightDB16 += wMain; else totalWeightDB12 += wMain;
                totalWeightRB9 += (wTie + wPerim);

                const singleTotalSteel = wMesh + wMain + wTie + wPerim;

                breakdownData.push({
                    grid: item.grid,
                    type: item.type,
                    dim: `${t.b.toFixed(2)}x${t.l.toFixed(2)}x${t.h.toFixed(2)}`,
                    mesh: t.meshSpec,
                    perim: t.perimTie,
                    main: t.mainBar,
                    tie: t.tieSpec,
                    steelPerUnit: singleTotalSteel
                });
            });

            const concWasted = totalVolConc * 1.05;
            const db12Wasted = totalWeightDB12 * 1.10;
            const db16Wasted = totalWeightDB16 * 1.10;
            const rb9Wasted = totalWeightRB9 * 1.10;
            const formWasted = totalFormworkArea * 1.05;

            const totalSteelKg = db12Wasted + db16Wasted + rb9Wasted;

            const items = [
                { name: '1. คอนกรีตโครงสร้าง 240 ksc (ฐานราก + เสาตอม่อ) [เผื่อ 5%]', qty: concWasted, unit: 'ลบ.ม.', price: pConc },
                { name: '2. เหล็กข้ออ้อย DB12 (ตะแกรงฐานราก/เสาตอม่อ) [เผื่อ 10%]', qty: db12Wasted, unit: 'กก.', price: pSteelDB },
                { name: '3. เหล็กข้ออ้อย DB16 (ฐานราก/เสาตอม่อใหญ่) [เผื่อ 10%]', qty: db16Wasted, unit: 'กก.', price: pSteelDB },
                { name: '4. เหล็กเส้นกลม RB9 (เหล็กปลอกเสา + เหล็กรัดรอบฐานราก) [เผื่อ 10%]', qty: rb9Wasted, unit: 'กก.', price: pSteelRB },
                { name: '5. ไม้แบบหล่อคอนกรีตฐานรากและเสาตอม่อ [เผื่อ 5%]', qty: formWasted, unit: 'ตร.ม.', price: pForm }
            ];

            let grandTotal = 0;
            const tbody = document.getElementById('boq-table-body');
            tbody.innerHTML = '';

            items.forEach((item, idx) => {
                const amount = item.qty * item.price;
                grandTotal += amount;

                const row = `
                    <tr class="hover:bg-slate-800/50 transition">
                        <td class="py-3 px-4 text-center font-sans text-slate-500">${idx + 1}</td>
                        <td class="py-3 px-4 font-sans font-semibold text-slate-200">${item.name}</td>
                        <td class="py-3 px-4 text-center text-sky-400 font-bold">${item.qty.toFixed(2)}</td>
                        <td class="py-3 px-4 text-center text-slate-400 font-sans">${item.unit}</td>
                        <td class="py-3 px-4 text-right">${item.price.toLocaleString('th-TH', {minimumFractionDigits: 2})}</td>
                        <td class="py-3 px-4 text-right font-bold text-emerald-400">${amount.toLocaleString('th-TH', {minimumFractionDigits: 2})}</td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', row);
            });

            document.getElementById('summary-steel-weight').innerText = `${totalSteelKg.toFixed(1)} kg`;
            document.getElementById('summary-conc-vol').innerText = `${concWasted.toFixed(2)} m³`;
            document.getElementById('summary-total-cost').innerText = `฿${grandTotal.toLocaleString('th-TH', {maximumFractionDigits: 0})}`;

            document.getElementById('boq-header-steel').innerText = `${totalSteelKg.toFixed(1)} kg`;
            document.getElementById('boq-header-conc').innerText = `${concWasted.toFixed(2)} m³`;
            document.getElementById('boq-header-total').innerText = `฿${grandTotal.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
            document.getElementById('boq-grand-total').innerText = `฿${grandTotal.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;

            renderBreakdownTable(breakdownData);
        }

        function renderBreakdownTable(data) {
            const tbody = document.getElementById('rebar-breakdown-body');
            tbody.innerHTML = '';

            const grouped = {};
            data.forEach(d => {
                if(!grouped[d.type]) grouped[d.type] = { count: 0, ...d };
                grouped[d.type].count += 1;
            });

            Object.keys(grouped).forEach(k => {
                const item = grouped[k];
                const totalSteel = item.steelPerUnit * item.count * 1.10;
                const row = `
                    <tr class="hover:bg-slate-800/40">
                        <td class="p-2.5 border border-slate-800 font-bold text-sky-400 font-sans">${item.type}</td>
                        <td class="p-2.5 border border-slate-800">${item.dim}</td>
                        <td class="p-2.5 border border-slate-800 font-bold text-white font-sans">${item.count}</td>
                        <td class="p-2.5 border border-slate-800 text-amber-300">${item.mesh}</td>
                        <td class="p-2.5 border border-slate-800 text-pink-400">${item.perim}</td>
                        <td class="p-2.5 border border-slate-800 text-orange-400">${item.main}</td>
                        <td class="p-2.5 border border-slate-800 text-yellow-300">${item.tie}</td>
                        <td class="p-2.5 border border-slate-800">${item.steelPerUnit.toFixed(1)} kg</td>
                        <td class="p-2.5 border border-slate-800 font-bold text-emerald-400">${totalSteel.toFixed(1)} kg</td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', row);
            });
        }

        // --- 6. CONTROLS & EVENT HANDLERS ---
        function updateConcreteOpacity(val) {
            concreteOpacity = val / 100;
            if(concreteMat) concreteMat.opacity = concreteOpacity;
            document.getElementById('opacity-val').innerText = `${val}%`;
        }

        function toggleRebarMaterialMode(mode) {
            isMetallicMode = (mode === 'metallic');
            buildCompleteModel();
        }

        function toggleLayer(layerName, visible) {
            if (layerName === 'rebars') rebarGroup.visible = visible;
            if (layerName === 'perimTies') perimTieGroup.visible = visible;
            if (layerName === 'concrete') concreteGroup.visible = visible;
            if (layerName === 'superstructure') superstructureGroup.visible = visible;
            if (layerName === 'grid') gridGroup.visible = visible;
        }

        function onCanvasClick(event) {
            const rect = renderer.domElement.getBoundingClientRect();
            mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
            mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(interactiveObjects);

            if (intersects.length > 0) {
                const data = intersects[0].object.userData;
                const typeInfo = data.typeData;

                const card = document.getElementById('info-card');
                document.getElementById('card-tag').innerText = data.type;
                document.getElementById('card-grid').innerText = `ตำแหน่ง Grid: ${data.grid} (เสา ${data.col})`;
                document.getElementById('card-dim').innerText = `${typeInfo.b.toFixed(2)} x ${typeInfo.l.toFixed(2)} x ${typeInfo.h.toFixed(2)} ม.`;
                document.getElementById('card-rebar-mesh').innerText = typeInfo.meshSpec;
                document.getElementById('card-rebar-perim').innerText = typeInfo.perimTie;
                document.getElementById('card-rebar-col').innerText = typeInfo.mainBar;
                document.getElementById('card-rebar-tie').innerText = typeInfo.tieSpec;

                const vol = typeInfo.b * typeInfo.l * typeInfo.h + (0.2 * 0.2 * stubHeight);
                document.getElementById('card-vol').innerText = `${vol.toFixed(3)} m³`;

                card.classList.remove('hidden');
            }
        }

        function hideInfoCard() {
            document.getElementById('info-card').classList.add('hidden');
        }

        function onParameterChange() {
            const val = parseFloat(document.getElementById('param-stub-height').value);
            if (!isNaN(val) && val > 0) {
                stubHeight = val;
                buildCompleteModel();
                calculateBOQ();
            }
        }

        function switchTab(tab) {
            const view3D = document.getElementById('view-3d');
            const viewBOQ = document.getElementById('view-boq');
            const btn3D = document.getElementById('tab-btn-3d');
            const btnBOQ = document.getElementById('tab-btn-boq');

            if (tab === '3d') {
                view3D.classList.remove('hidden');
                viewBOQ.classList.add('hidden');
                btn3D.className = 'px-4 py-1.5 rounded-lg text-xs font-semibold bg-sky-600 text-white shadow flex items-center gap-2';
                btnBOQ.className = 'px-4 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-750 border border-slate-700 flex items-center gap-2';
                setTimeout(onWindowResize, 50);
            } else {
                view3D.classList.add('hidden');
                viewBOQ.classList.remove('hidden');
                btnBOQ.className = 'px-4 py-1.5 rounded-lg text-xs font-semibold bg-sky-600 text-white shadow flex items-center gap-2';
                btn3D.className = 'px-4 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-750 border border-slate-700 flex items-center gap-2';
            }
        }

        function resetAllDefaults() {
            document.getElementById('concrete-opacity').value = 35;
            updateConcreteOpacity(35);
            document.getElementById('toggle-rebars').checked = true; toggleLayer('rebars', true);
            document.getElementById('toggle-perim-ties').checked = true; toggleLayer('perimTies', true);
            document.getElementById('toggle-concrete').checked = true; toggleLayer('concrete', true);
            document.getElementById('toggle-superstructure').checked = true; toggleLayer('superstructure', true);
            document.getElementById('toggle-grid').checked = true; toggleLayer('grid', true);
            document.getElementById('param-stub-height').value = 1.5;
            stubHeight = 1.5;
            buildCompleteModel();
            calculateBOQ();
        }

        function clearGroup(group) {
            while(group.children.length > 0){
                const obj = group.children[0];
                group.remove(obj);
            }
        }

        function exportToCSV() {
            let csv = '\uFEFFลำดับ,รายการวัสดุ,ปริมาณ,หน่วย,ราคา/หน่วย(บาท),จำนวนเงิน(บาท)\n';
            const rows = document.querySelectorAll('#boq-table-body tr');
            rows.forEach(row => {
                const cols = row.querySelectorAll('td');
                const rowData = Array.from(cols).map(c => `"${c.innerText.trim()}"`).join(',');
                csv += rowData + '\n';
            });

            const link = document.createElement('a');
            link.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
            link.setAttribute('download', 'Rebar_BOQ_Report.csv');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function onWindowResize() {
            const container = document.getElementById('view-3d');
            if(!container || !renderer || !camera) return;
            const w = container.clientWidth;
            const h = container.clientHeight;
            if (w === 0 || h === 0) return;

            camera.aspect = w / h;
            camera.updateProjectionMatrix();
            renderer.setSize(w, h);
        }

        function animate() {
            requestAnimationFrame(animate);
            if (controls) controls.update();
            if (renderer && scene && camera) renderer.render(scene, camera);
        }
    </script>
</body>
</html>
